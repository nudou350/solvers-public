# /etc/nginx/sites-available/solvers  (ln -s em sites-enabled)
# Um domínio só: a vitrine (Next.js) em / e o servidor Node em /api, /mcp, /oauth, /.well-known,
# /webhooks, /preview e /health. Assim não há CORS e o cookie de sessão é do mesmo site.

# Upload de pacotes (POST /api/creator/submissions). Este arquivo é incluído dentro de http{}, então map e limit_req_zone
# podem ficar aqui (sem editar o nginx.conf compartilhado). Os nomes são globais no nginx: o prefixo solvers_ evita colisão
# com outros sites. A chave só existe para POST (chave vazia não é contada), então GET de consulta de status não entra na zona.
# 6 envios/min por IP já é folga: o app limita a 5 por dia e 3 pendentes por criador.
map $request_method $solvers_upload_key {
    POST    $binary_remote_addr;
    default "";
}
limit_req_zone $solvers_upload_key zone=solvers_upload:10m rate=6r/m;

upstream solvers_api {
    server 127.0.0.1:3017;
    keepalive 64;
}

upstream solvers_web {
    server 127.0.0.1:4017;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name solvers.wondervelop.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name solvers.wondervelop.com;

    ssl_certificate /etc/letsencrypt/live/solvers.wondervelop.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/solvers.wondervelop.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

    client_max_body_size 2m;

    # Conector MCP: sem buffer (streaming) e com timeout longo.
    location = /mcp {
        proxy_pass http://solvers_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
    }

    location ~ ^/(oauth/|\.well-known/oauth-|\.well-known/openid-configuration$|webhooks/|preview/|health$) {
        limit_req zone=api burst=20 nodelay;
        proxy_pass http://solvers_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Upload do ZIP do criador (até 50 MB; teto do nginx 60m). Corpo em streaming: o nginx repassa à API conforme recebe, sem
    # gravar o corpo no disco do sistema (compartilhado com outros projetos). A autenticação é conferida pela API antes de ler o corpo.
    # Rota exata: só esta URL. GET /api/creator/submissions (lista) cai aqui também, mas sem a zona de upload (chave vazia);
    # /api/creator/submissions/<id> e o resto de /api seguem em "location /api" com o limite de 2m de corpo.
    location = /api/creator/submissions {
        limit_req zone=api burst=20 nodelay;
        limit_req zone=solvers_upload burst=3 nodelay;
        limit_req_status 429;
        client_max_body_size 60m;
        client_body_buffer_size 256k;
        client_body_timeout 120s;     # tempo máximo SEM receber bytes do cliente (reinicia a cada leitura), não do upload todo
        proxy_request_buffering off;
        proxy_pass http://solvers_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_send_timeout 300s;      # entre escritas ao upstream; a API grava em disco, então só estoura se ela travar
        proxy_read_timeout 300s;      # a API responde 202 depois de gravar o ZIP
    }

    location /api/auth {
        limit_req zone=login burst=5 nodelay;
        proxy_pass http://solvers_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api {
        limit_req zone=api burst=20 nodelay;
        proxy_pass http://solvers_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    # Assets com hash do Next: uma página carrega dezenas de chunks de uma vez, e o limite da
    # zona "general" (10 req/s) os recusava com 503 (erro de MIME no navegador). Sem limite aqui.
    location /_next/static/ {
        proxy_pass http://solvers_web;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Vitrine (Next.js). Enquanto o front não estiver no ar, o nginx devolve 502 aqui.
    # burst alto: cada link visível dispara um prefetch (?_rsc=) junto com a navegação.
    location / {
        limit_req zone=general burst=60 nodelay;
        proxy_pass http://solvers_web;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/javascript application/json application/javascript image/svg+xml;
}
