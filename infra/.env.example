# apps/server/.env na VPS (/var/www/solvers/backend/.env), chmod 600. Nunca commitar.
NODE_ENV=production
PORT=3017
PUBLIC_API_URL=https://solvers.wondervelop.com
PUBLIC_WEB_URL=https://solvers.wondervelop.com
SIWS_DOMAIN=solvers.wondervelop.com

# PG16 da VPS (porta 5433) com a extensão pgvector
DATABASE_URL=postgres://solvers_user:TROCAR@127.0.0.1:5433/solvers

SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com      # ou https://devnet.helius-rpc.com/?api-key=...
USDC_MINT=                                        # mint de USDC de teste (scripts: bootstrap)
PRIORITY_FEE_MICROLAMPORTS=0

# Chaves do servidor: JSON (array), base58 ou caminho de arquivo. A carteira admin NÃO fica na VPS.
FEE_PAYER_KEYPAIR=/var/www/solvers/keys/fee-payer.json
VERIFIER_KEYPAIR=/var/www/solvers/keys/verifier.json
USAGE_AUTHORITY_KEYPAIR=/var/www/solvers/keys/usage.json
# ADMIN_KEYPAIR=                                  # só na máquina do time (aprovar solvers, resolver disputas)

HELIUS_WEBHOOK_SECRET=                            # header Authorization configurado no webhook da Helius
INDEXER_POLL_MS=10000

JWT_SECRET=                                       # 32+ bytes aleatórios: openssl rand -hex 32
SERVER_KEK=                                       # 32 bytes base64: openssl rand -base64 32

FAUCET_ENABLED=true                               # só na devnet
FAUCET_AMOUNT_USDC=50
BRL_PER_USD=5.4

TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

EMBEDDING_MODEL=Xenova/multilingual-e5-small
SEARCH_MODE=local

AGENTS_DIR=/var/www/solvers/agents
DELIVERABLES_DIR=/var/www/solvers/deliverables
VERIFIER_MODE=docker
VERIFIER_IMAGE=solvers-react-test
ESCROW_REVIEW_WINDOW_SECS=259200                  # 72h (para a demo, 300 = 5 min)
